# Organizer-provided HTTPS origin. REST, MCP, and proxy traffic share this origin.
# Loopback development may still use ARENA_SERVER=127.0.0.1 with service ports.
ARENA_SERVER=https://arena.example.com

# Organizer-provided battle or practice key. This same key is used for
# REST, MCP, and LLM proxy access.
ARENA_API_KEY=

# Competitors do not need a separate provider key. The server-side proxy handles
# upstream OpenRouter access.

# Team identity and strategy settings now live in:
#   my_strategy.py
